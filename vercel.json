{
  "framework": "nextjs",
  "outputDirectory": ".next",
  "buildCommand": "pnpm run vercel-build",
  "devCommand": "pnpm turbo dev",
  "functions": {
    "api/ws.ts": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/editor",
      "destination": "/editor/"
    },
    {
      "source": "/editor/(.*)",
      "destination": "/editor/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.js|.*\\.css|.*\\.woff2)",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
