{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd ../../.. && node scripts/vercel-build.mjs && pnpm turbo run build --filter=@aether/converge-server",
  "functions": {
    "api/ws.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/health.ts": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
