{
  "name": "@aether/editor-host",
  "version": "0.0.1",
  "description": "Aether 编辑器宿主的 Current 渲染层与 Drift 持久化入口。",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "probe": "tsx probes/serverless.ts"
  },
  "dependencies": {
    "@hocuspocus/provider": "^2.15.3",
    "@aether/current-sync": "workspace:*",
    "@aether/types": "workspace:*",
    "@aether/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@aether/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.0",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  }
}
