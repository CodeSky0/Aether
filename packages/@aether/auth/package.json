{
  "name": "@aether/auth",
  "version": "0.0.1",
  "description": "Aether 认证与授权适配层：Better-Auth 三级 Realm Tree 权限模型封装。下游禁止直接依赖 Better-Auth。",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.js"
    },
    "./instance": {
      "types": "./dist/instance.d.ts",
      "import": "./dist/instance.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "backfill:realm-orgs": "tsx scripts/backfill-realm-organizations.ts"
  },
  "dependencies": {
    "@aether/db": "workspace:*",
    "@aether/types": "workspace:*",
    "better-auth": "1.6.26",
    "drizzle-orm": "^0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aether/config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "postgres": "^3.4.5",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
