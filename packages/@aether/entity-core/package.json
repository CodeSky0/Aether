{
  "name": "@aether/entity-core",
  "version": "0.0.1",
  "description": "Aether Entity 运行时核心：Capability Manifesto、Handoff Gate 状态机、Entity Audit Trail、Entity Identity 与 Presence Cursor 适配。",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifesto": {
      "types": "./dist/manifesto.d.ts",
      "import": "./dist/manifesto.js"
    },
    "./handoff": {
      "types": "./dist/handoff.d.ts",
      "import": "./dist/handoff.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "import": "./dist/presence.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aether/auth": "workspace:*",
    "@aether/current-sync": "workspace:*",
    "@aether/db": "workspace:*",
    "@aether/types": "workspace:*",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.59",
    "@ai-sdk/xai": "^4.0.54",
    "ai": "^7.0.93",
    "drizzle-orm": "^0.45.2",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@aether/config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
